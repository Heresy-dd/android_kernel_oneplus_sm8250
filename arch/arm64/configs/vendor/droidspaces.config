# CONFIG_ANDROID_PARANOID_NETWORK is not set

# Disable OnePlus/QCOM charger drivers — schgm-flash.c, qpnp-fg-gen4.c and
# friends rely on OPLUS_FEATURE_CHG_BASIC being defined externally to bring
# in their struct/symbol definitions. That macro isn't set in this tree, so
# the resulting compile picks up forward-declared structs and undefined
# helpers (smb_charger, smb_irq_data, smblib_read/write, ...). Turning the
# offending modules off lets the kernel link; charging isn't needed for CI.
# CONFIG_QPNP_SMB5 is not set
# CONFIG_QPNP_FG_GEN4 is not set
# CONFIG_QPNP_QNOVO5 is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
